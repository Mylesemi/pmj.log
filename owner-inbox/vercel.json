{
  "buildCommand": "node scripts/check-inbox.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/inbox-sync.js": { "maxDuration": 30 },
    "api/github-setup.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action https://github.com" }
      ]
    }
  ]
}
